<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SafeCallRecorder" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">#3D5AFE</item>
        <item name="colorPrimaryVariant">#0031CA</item>
        <item name="colorOnPrimary">@android:color/white</item>
        
        <!-- Secondary colors -->
        <item name="colorSecondary">#00BFA5</item>
        <item name="colorSecondaryVariant">#008E76</item>
        <item name="colorOnSecondary">@android:color/white</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">?android:colorBackground</item>
        <item name="android:navigationBarColor">?android:colorBackground</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
